<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_invoice_import_simple_pdf.view_partner_property_form"/>
        <field name="arch" type="xml">
             <xpath expr="//button[@name='pdf_simple_generate_default_fields']" position="after">
                <button
                    name="action_simple_pdf_ai_extraction"
                    type="object"
                    string="Detect Rules with AI"
                    class="btn-secondary"
                    colspan="2"
                    invisible="simple_pdf_field_ids"
                />
            </xpath>
        </field>
    </record>
</odoo>
