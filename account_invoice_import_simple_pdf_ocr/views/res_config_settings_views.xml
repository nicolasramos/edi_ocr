<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                 <setting id="simple_pdf_ocr_ai" title="AI Extraction Rules (Ollama)" string="AI Extraction Rules">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="ollama_endpoint" class="col-lg-3 o_light_label"/>
                            <field name="ollama_endpoint"/>
                        </div>
                        <div class="row mt16">
                            <label for="ollama_model" class="col-lg-3 o_light_label"/>
                            <field name="ollama_model" class="oe_inline"/>
                            <button name="action_download_ollama_model" type="object" string="Download / Pull Model" class="btn-secondary oe_inline btn-sm" style="margin-left: 10px;" display="inline" title="Triggers a download of the model to the Ollama server."/>
                        </div>
                        <div class="row mt16">
                            <label for="ollama_prompt" class="col-lg-3 o_light_label"/>
                            <field name="ollama_prompt" style="width: 100%; min-height: 150px;"/>
                        </div>
                    </div>
                 </setting>
                 <setting id="simple_pdf_ocr_engine" title="OCR Engine" string="OCR Engine">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="ocr_engine" class="col-lg-3 o_light_label"/>
                            <field name="ocr_engine"/>
                        </div>
                        <div class="row mt16" invisible="ocr_engine != 'paddle'">
                            <label for="paddle_lang" class="col-lg-3 o_light_label"/>
                            <field name="paddle_lang"/>
                        </div>
                    </div>
                 </setting>
            </xpath>
        </field>
    </record>
</odoo>
