<odoo>


    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field
            name="inherit_id"
            ref="account_invoice_import.view_partner_property_form"
        />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <page name="accounting" position="after">
                <page
                    name="invoice_import_simple_pdf"
                    string="Importación de Facturas de Proveedor"
                    attrs="{'invisible': ['|', ('parent_id', '!=', False), ('is_company', '=', False)]}"
                    groups="account.group_account_invoice,account.group_account_readonly"
                >
                    <group
                        name="invoice_import_config"
                        position="move"
                    /> <!-- TODO make it work -->
                    <group name="simple_pdf_main">
                        <group name="simple_pdf_main-left">
                        <field name="simple_pdf_keyword" string="Palabras Clave" />
                        <field name="simple_pdf_pages" widget="radio" />
                        <field
                                name="simple_pdf_currency_id"
                                string="Moneda de Factura"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                </group>
                        <group name="simple_pdf_main-right">
                        <field name="simple_pdf_date_format" string="Formato de Fecha" />
                        <field
                                name="simple_pdf_date_separator"
                                string="Separador de Fecha"
                            />
                        <field
                                name="simple_pdf_decimal_separator"
                                string="Separador Decimal"
                            />
                        <field
                                name="simple_pdf_thousand_separator"
                                string="Separador de Miles"
                            />
                        <field name="simple_pdf_test_filename" invisible="1" />
                    </group>
                    </group>
                    <group
                        name="invoice_import_simple_pdf_number"
                        string="Formato de Número de Factura"
                    >
                            <field
                            name="simple_pdf_invoice_number_ids"
                            nolabel="1"
                            colspan="2"
                        />
                    </group>
                    <group
                        name="invoice_import_simple_pdf_fields"
                        string="Reglas de Extracción de Campos"
                    >
                        <button
                            name="pdf_simple_generate_default_fields"
                            type="object"
                            string="Generar Reglas de Extracción Predeterminadas"
                            attrs="{'invisible': [('simple_pdf_field_ids', '!=', [])]}"
                            colspan="2"
                        />
                        <field name="simple_pdf_field_ids" nolabel="1" colspan="2" />
                    </group>
                    <group name="pdf_simple_test" string="Archivo de Prueba" col="4">
                                <field
                            name="simple_pdf_test_file"
                            filename="simple_pdf_test_filename"
                        />
                                <button
                            type="object"
                            name="pdf_simple_test_run"
                            string="Ejecutar Prueba"
                            class="btn-primary"
                        />
                                <button
                            name="pdf_simple_test_cleanup"
                            type="object"
                            string="Limpiar Datos de Prueba"
                            attrs="{'invisible': [( 'simple_pdf_test_file', '=', False), ('simple_pdf_test_results', '=', False), ('simple_pdf_test_raw_text', '=', False)]}"
                        />

                            </group>
                            <group name="pdf_simple_test_results" string="Resultados de la Prueba">
                                <field
                            nolabel="1"
                            name="simple_pdf_test_results"
                            colspan="2"
                        />
                        </group>
                        <group
                        name="pdf_simple_test_raw_text"
                        string="Extracción de Texto desde PDF"
                        attrs="{'invisible': [('simple_pdf_test_raw_text', '=', False)]}"
                    >
                                <field
                            nolabel="1"
                            name="simple_pdf_test_raw_text"
                            colspan="2"
                        />
                        </group>

                </page>
            </page>
        </field>
    </record>


</odoo>
